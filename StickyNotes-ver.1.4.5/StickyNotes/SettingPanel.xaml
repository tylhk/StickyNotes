<Window x:Class="StickyNotes.SettingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyNotes"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="关于项目" Height="312" Width="328">

    <!-- 主 Grid：包含所有内容 -->
    <Grid Margin="21,11,21,45">

        <!-- 定义资源：按钮样式 -->
        <Grid.Resources>
            <Style x:Key="NoFocusRectangleButtonStyle" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- 可选：移除鼠标悬停/按下时的默认动画效果 -->
                <Setter Property="Focusable" Value="False"/>
            </Style>
        </Grid.Resources>

        <!-- 行定义：用于布局 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 用户信息 -->
            <RowDefinition Height="Auto"/>
            <!-- 版本 -->
            <RowDefinition Height="Auto"/>
            <!-- 链接1 -->
            <RowDefinition Height="Auto"/>
            <!-- 链接2 -->
            <RowDefinition Height="*"/>
            <!-- 剩余空间 -->
        </Grid.RowDefinitions>

        <!-- 第一行：用户信息 -->
        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 头像 -->
            <Ellipse Width="80" Height="80" Margin="10">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="icon/satone.jpg"/>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 名称和描述 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="StickyNotes" FontSize="20" FontWeight="Bold"/>
                <TextBlock FontSize="14" Text="Developed by Satone"/>
            </StackPanel>
        </Grid>

        <!-- 第二行：版本 -->
        <Label Name="labelVersion"
               Grid.Row="1"

               HorizontalAlignment="Left"
               Height="35"
               Width="328"
               Margin="10,5,0,0"/>

        <!-- 第三行：访问项目地址 -->
        <Button Grid.Row="2"
                Click="OpenGitHubLink"
                HorizontalAlignment="Left"
                Width="128"
                Height="25"
                Margin="-15,5,0,0"
                Background="Transparent"
                BorderBrush="{x:Null}"
                Cursor="Hand"
                Padding="0"
                Style="{StaticResource NoFocusRectangleButtonStyle}">
            <TextBlock Text="访问项目地址"
                       Foreground="Blue"
                       TextDecorations="Underline"
                       FontSize="12"/>
        </Button>

        <!-- 第四行：访问我的博客 -->
        <Button Grid.Row="3"
                Click="OpenBlogLink"
                HorizontalAlignment="Left"
                Width="128"
                Height="25"
                Margin="-15,5,0,0"
                Background="Transparent"
                BorderBrush="{x:Null}"
                Cursor="Hand"
                Padding="0"
                Style="{StaticResource NoFocusRectangleButtonStyle}">
            <TextBlock Text="访问我的博客"
                       Foreground="Blue"
                       TextDecorations="Underline"
                       FontSize="12"/>
        </Button>

    </Grid>
</Window>